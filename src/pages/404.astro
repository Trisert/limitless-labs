---
import Base from "../layouts/Base.astro";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<Base
  title="404 — Signal lost · Limitless Labs"
  description="The requested page was not found."
  bodyClass="post"
>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <main id="main-content">
    <div class="wrap">
      <p class="log-date">404 · SIGNAL LOST</p>
      <div class="prose">
        <h1>Transmission not found.</h1>
        <p>
          The page you requested doesn't exist — the signal may have drifted or
          the log entry moved.
        </p>
        <p>
          <a href={`${base}`}>Return to base</a> or <a href={`${base}#writing`}
            >browse the field notes</a
          >.
        </p>
      </div>
    </div>
  </main>
  <footer>
    <div class="wrap article-footer">Built on Earth, aimed at orbit.</div>
  </footer>
</Base>
